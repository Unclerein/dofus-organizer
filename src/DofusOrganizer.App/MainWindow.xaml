<Window x:Class="DofusOrganizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DofusOrganizer.App.ViewModels"
        xmlns:models="clr-namespace:DofusOrganizer.Core.Models;assembly=DofusOrganizer.Core"
        xmlns:views="clr-namespace:DofusOrganizer.App.Views"
        Title="Dofus Organizer" Height="680" Width="1000" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Parchment}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI" FontSize="12.5"
        TextOptions.TextFormattingMode="Display">
  <DockPanel>

    <!-- Barre d'état : compteur de clients, message courant et arrêt d'urgence -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Leather}"
            BorderBrush="{StaticResource Gold}" BorderThickness="0,2,0,0" Padding="12,7"
            TextElement.Foreground="{StaticResource GoldSoft}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding PresentCount}" FontWeight="SemiBold"
                   Foreground="{StaticResource GoldBright}" Margin="0,0,14,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <Button Grid.Column="2" Content="Arrêter la macro" Command="{Binding StopMacroCommand}"
                Style="{StaticResource DangerButton}" Margin="10,0,0,0" />
      </Grid>
    </Border>

    <TabControl>

      <!-- ============ Personnages ============ -->
      <TabItem Header="Personnages">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Style="{StaticResource Hint}">
            Sélectionnez un personnage puis « Assigner » et appuyez sur la touche voulue.
            L'ordre de cette liste est celui que suit la touche « personnage suivant » et les boucles de macro.
          </TextBlock>

          <DataGrid Grid.Row="1" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}"
                    views:DragReorder.Command="{Binding ReorderCharactersCommand}"
                    AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                    SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding PositionLabel}" IsReadOnly="True" Width="34" />
              <DataGridCheckBoxColumn Header="Actif" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="50"
                                      ElementStyle="{StaticResource GridCheckBox}"
                                      EditingElementStyle="{StaticResource GridCheckBox}" />
              <DataGridTextColumn Header="Personnage" Binding="{Binding DisplayName, UpdateSourceTrigger=LostFocus}" Width="2*" />
              <DataGridTextColumn Header="Raccourci" Binding="{Binding HotkeyLabel}" IsReadOnly="True" Width="130" />
              <DataGridTextColumn Header="État" Binding="{Binding StatusLabel}" IsReadOnly="True" Width="100" />
              <DataGridTextColumn Header="Titre de la fenêtre" Binding="{Binding WindowTitle}" IsReadOnly="True" Width="3*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="2,0" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <!-- La classe Win32 ne mérite pas une colonne, mais c'est elle qu'attend le filtre des Réglages. -->
                    <Setter Property="ToolTip" Value="{Binding WindowClass, StringFormat={}Classe de fenêtre : {0}}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>

          <WrapPanel Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Monter" Command="{Binding MoveCharacterUpCommand}" />
            <Button Content="Descendre" Command="{Binding MoveCharacterDownCommand}" />
            <Button Content="Assigner" Command="{Binding AssignCharacterHotkeyCommand}" />
            <Button Content="Effacer la touche" Command="{Binding ClearCharacterHotkeyCommand}" MinWidth="120" />
            <Button Content="Aller dessus" Command="{Binding FocusCharacterCommand}" MinWidth="100" />
            <Button Content="Oublier" Command="{Binding ForgetCharacterCommand}"
                    ToolTip="Retire de la liste un personnage dont le client est fermé." />
            <Button Content="Oublier les absents" Command="{Binding ForgetAbsentCharactersCommand}" MinWidth="140"
                    ToolTip="Retire d'un coup tous les personnages dont le client est fermé, avec leurs raccourcis." />
            <Button Content="Rafraîchir" Command="{Binding RefreshCommand}" />
          </WrapPanel>
        </Grid>
      </TabItem>

      <!-- ============ Macros ============ -->
      <TabItem Header="Macros">
        <Grid Margin="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- Liste des macros -->
          <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Button Content="Nouvelle" Command="{Binding AddMacroCommand}" MinWidth="80" />
              <Button Content="Supprimer" Command="{Binding DeleteMacroCommand}" MinWidth="80" Margin="0" />
            </WrapPanel>
            <ListBox ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="2,4">
                    <TextBlock Text="{Binding Macro.Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Macro.Summary}" Style="{StaticResource Secondary}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <!-- Éditeur de la macro sélectionnée -->
          <Grid Grid.Column="1" DataContext="{Binding SelectedMacro}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Nom" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Text="{Binding Macro.Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="2" Text="{Binding Macro.Hotkey, TargetNullValue=(aucun raccourci)}"
                           VerticalAlignment="Center" Margin="12,0,8,0" FontWeight="SemiBold"
                           Foreground="{StaticResource Wood}" />
                <Button Grid.Column="3" Content="Assigner"
                        Command="{Binding DataContext.AssignMacroHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Grid.Column="4" Content="Effacer"
                        Command="{Binding DataContext.ClearMacroHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        MinWidth="70" Margin="0" />
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Content="Revenir sur la fenêtre de départ" IsChecked="{Binding Macro.RestoreInitialWindow}" Margin="0,0,16,0" />
                <CheckBox Content="Remettre le curseur en place" IsChecked="{Binding Macro.RestoreCursorPosition}" />
              </StackPanel>
              <TextBlock Text="Étapes" Style="{StaticResource SectionHeader}" />
            </StackPanel>

            <!--
              Une ligne par étape, sous-étapes comprises et sélectionnables. Elles étaient
              auparavant dessinées par une liste imbriquée en lecture seule : tout ce qui vivait
              dans une boucle échappait à la sélection, donc aux boutons Monter, Descendre,
              Supprimer et Ajouter — alors que le modèle savait les traiter depuis toujours.
            -->
            <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                     views:DragReorder.Command="{Binding DataContext.ReorderStepsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Step.Description}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <!-- Le retrait dit l'appartenance à la boucle ; l'imbrication ne va pas plus loin. -->
                          <DataTrigger Binding="{Binding Depth}" Value="1">
                            <Setter Property="Margin" Value="22,0,0,0" />
                            <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
                            <Setter Property="FontSize" Value="11.5" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Panneau de propriétés, adapté au type d'étape sélectionné -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10" Margin="0,8,0,0"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
              <ContentControl Content="{Binding SelectedStep}">
                <ContentControl.Resources>

                  <DataTemplate DataType="{x:Type models:MouseClickStep}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Bouton" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <ComboBox SelectedValue="{Binding Button}" Width="90" Margin="0,0,14,0"
                        ItemsSource="{x:Static vm:Choices.MouseButtons}"
                        SelectedValuePath="Value" DisplayMemberPath="Label" />
                      <TextBlock Text="X %" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBox Text="{Binding Fx, StringFormat=F4, UpdateSourceTrigger=LostFocus}" Width="72" Margin="0,0,14,0" />
                      <TextBlock Text="Y %" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBox Text="{Binding Fy, StringFormat=F4, UpdateSourceTrigger=LostFocus}" Width="72" Margin="0,0,14,0" />
                      <TextBlock Text="Répétitions" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBox Text="{Binding Clicks, UpdateSourceTrigger=LostFocus}" Width="44" />
                      <Button Content="Pointer"
                              Command="{Binding DataContext.PointStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="départ" MinWidth="80" Margin="14,0,0,0"
                              ToolTip="Cliquez ensuite l'endroit voulu dans le jeu : le clic n'y parviendra pas, seule sa position est retenue. Montrez-le dans un client dont la disposition est celle du rejeu — la position est relative à la fenêtre cliquée." />
                    </StackPanel>
                  </DataTemplate>

                  <DataTemplate DataType="{x:Type models:MouseDragStep}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Bouton" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <ComboBox SelectedValue="{Binding Button}" Width="90" Margin="0,0,14,0"
                        ItemsSource="{x:Static vm:Choices.MouseButtons}"
                        SelectedValuePath="Value" DisplayMemberPath="Label" />
                      <TextBlock Text="Saisir à" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBox Text="{Binding Fx, StringFormat=F4, UpdateSourceTrigger=LostFocus}" Width="66" Margin="0,0,4,0" />
                      <TextBox Text="{Binding Fy, StringFormat=F4, UpdateSourceTrigger=LostFocus}" Width="66" Margin="0,0,14,0" />
                      <TextBlock Text="Déposer à" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBox Text="{Binding ToFx, StringFormat=F4, UpdateSourceTrigger=LostFocus}" Width="66" Margin="0,0,4,0" />
                      <TextBox Text="{Binding ToFy, StringFormat=F4, UpdateSourceTrigger=LostFocus}" Width="66" Margin="0,0,14,0" />
                      <TextBlock Text="Étapes du trajet" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBox Text="{Binding IntermediateMoves, UpdateSourceTrigger=LostFocus}" Width="46" />
                      <Button Content="Pointer le départ"
                              Command="{Binding DataContext.PointStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="départ" MinWidth="80" Margin="14,0,0,0"
                              ToolTip="Cliquez ensuite l'endroit voulu dans le jeu : le clic n'y parviendra pas, seule sa position est retenue. Montrez-le dans un client dont la disposition est celle du rejeu — la position est relative à la fenêtre cliquée." />
                      <Button Content="Pointer l'arrivée"
                              Command="{Binding DataContext.PointStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="arrivée" MinWidth="80" Margin="6,0,0,0"
                              ToolTip="Cliquez ensuite l'endroit voulu dans le jeu : le clic n'y parviendra pas, seule sa position est retenue. Montrez-le dans un client dont la disposition est celle du rejeu — la position est relative à la fenêtre cliquée." />
                    </StackPanel>
                  </DataTemplate>

                  <DataTemplate DataType="{x:Type models:MouseMoveStep}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBox Text="{Binding Fx, StringFormat=F4, UpdateSourceTrigger=LostFocus}" Width="72" Margin="0,0,14,0" />
                      <TextBlock Text="Y" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBox Text="{Binding Fy, StringFormat=F4, UpdateSourceTrigger=LostFocus}" Width="72" />
                      <Button Content="Pointer"
                              Command="{Binding DataContext.PointStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="départ" MinWidth="80" Margin="14,0,0,0"
                              ToolTip="Cliquez ensuite l'endroit voulu dans le jeu : le clic n'y parviendra pas, seule sa position est retenue. Montrez-le dans un client dont la disposition est celle du rejeu — la position est relative à la fenêtre cliquée." />
                    </StackPanel>
                  </DataTemplate>

                  <DataTemplate DataType="{x:Type models:KeyStep}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Touche" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <ComboBox SelectedValue="{Binding VirtualKey}" Width="120" Margin="0,0,14,0"
                                ItemsSource="{x:Static vm:Choices.Keys}"
                                SelectedValuePath="Value" DisplayMemberPath="Label" />
                      <TextBlock Text="Action" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <ComboBox SelectedValue="{Binding Action}" Width="110"
                                ItemsSource="{x:Static vm:Choices.KeyActions}"
                                SelectedValuePath="Value" DisplayMemberPath="Label" />
                    </StackPanel>
                  </DataTemplate>

                  <DataTemplate DataType="{x:Type models:ScrollStep}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Sens" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <ComboBox SelectedValue="{Binding Direction}" Width="120" Margin="0,0,14,0"
                                ItemsSource="{x:Static vm:Choices.ScrollDirections}"
                                SelectedValuePath="Value" DisplayMemberPath="Label" />
                      <TextBlock Text="Crans" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBox Text="{Binding Notches, UpdateSourceTrigger=LostFocus}" Width="52" Margin="0,0,14,0" />
                      <TextBlock Text="X %" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBox Text="{Binding Fx, StringFormat=F4, UpdateSourceTrigger=LostFocus}" Width="72" Margin="0,0,14,0" />
                      <TextBlock Text="Y %" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBox Text="{Binding Fy, StringFormat=F4, UpdateSourceTrigger=LostFocus}" Width="72" />
                      <Button Content="Pointer"
                              Command="{Binding DataContext.PointStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="départ" MinWidth="80" Margin="14,0,0,0"
                              ToolTip="Cliquez ensuite l'endroit voulu dans le jeu : le clic n'y parviendra pas, seule sa position est retenue. Montrez-le dans un client dont la disposition est celle du rejeu — la position est relative à la fenêtre cliquée." />
                    </StackPanel>
                  </DataTemplate>

                  <DataTemplate DataType="{x:Type models:DelayStep}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Durée (ms)" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBox Text="{Binding Milliseconds, UpdateSourceTrigger=LostFocus}" Width="90" />
                    </StackPanel>
                  </DataTemplate>

                  <DataTemplate DataType="{x:Type models:FocusStep}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Cible" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <ComboBox SelectedValue="{Binding Target}" Width="150" Margin="0,0,14,0"
                                ItemsSource="{x:Static vm:Choices.FocusTargets}"
                                SelectedValuePath="Value" DisplayMemberPath="Label" />
                      <TextBlock Text="Personnage n°" VerticalAlignment="Center" Margin="0,0,6,0" />
                      <TextBox Text="{Binding SlotIndex, UpdateSourceTrigger=LostFocus}" Width="50" />
                    </StackPanel>
                  </DataTemplate>

                  <DataTemplate DataType="{x:Type models:DistributeQuantityStep}">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Diviser par" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Divisor, UpdateSourceTrigger=LostFocus}" Width="60" Margin="0,0,16,0" />
                        <TextBlock Text="Attendre l'ouverture (ms)" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding OpenDelayMs, UpdateSourceTrigger=LostFocus}" Width="60"
                                 ToolTip="Temps laissé à la boîte de quantité pour s'ouvrir avant de copier. Trop court, la copie ne rapporte rien et la macro s'arrête. À monter si un client est lent." />
                      </StackPanel>
                      <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0">
                        La part est calculée à la première lecture et reprise pour les personnages
                        suivants, pour que tous prennent la même chose alors que le coffre se vide.
                        Ce qui ne tombe pas juste y reste.
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>

                  <DataTemplate DataType="{x:Type models:ForEachCharacterStep}">
                    <StackPanel>
                      <CheckBox Content="Sauter le personnage qui a déjà le focus" IsChecked="{Binding SkipCurrentWindow}" />
                      <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0">
                        Les étapes enregistrées atterrissent dans cette boucle et sont rejouées sur chaque personnage actif.
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>

                </ContentControl.Resources>
              </ContentControl>
            </Border>

            <WrapPanel Grid.Row="3" Margin="0,10,0,0">
              <ComboBox Width="170" Margin="0,0,6,0" VerticalAlignment="Center"
                        ItemsSource="{x:Static vm:Choices.StepKinds}"
                        SelectedValuePath="Value" DisplayMemberPath="Label"
                        SelectedValue="{Binding DataContext.NewStepKind, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Button Content="Ajouter" Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="80" />
              <Button Content="Supprimer" Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="80" />
              <Button Content="Monter" Command="{Binding DataContext.MoveStepUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="70" />
              <Button Content="Descendre" Command="{Binding DataContext.MoveStepDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="80" />
              <Border Width="14" />
              <Button Content="{Binding DataContext.RecordingLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                      Command="{Binding DataContext.ToggleRecordingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      MinWidth="170" Style="{StaticResource GoldButton}" />
              <Button Content="Tester" Command="{Binding DataContext.RunMacroCommand, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="80" />
            </WrapPanel>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ============ Coffre ============ -->
      <TabItem Header="Coffre">
        <!--
          Ascenseur comme dans Réglages : c'est le seul autre onglet dont le contenu n'est pas
          borné par une grille. Sans lui, une fenêtre à sa taille par défaut coupait le bas du
          panneau — et le bouton de construction avec, sans moyen d'y descendre.
        -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MaxWidth="560" />
              <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="Répartir le coffre sur l'équipe" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
              <TextBlock Style="{StaticResource Hint}">
                Le meneur dépose tout au coffre, puis chaque personnage vient prendre sa part.
                La macro lit la quantité proposée par le jeu, la divise, et pose le résultat.
              </TextBlock>

              <TextBlock Text="1. Placez les personnages devant le coffre"
                         Style="{StaticResource SectionHeader}"
                         ToolTip="Ils doivent tous pouvoir l'ouvrir sans se déplacer : la macro clique au même endroit sur chacun." />

              <TextBlock Text="2. Désignez les points" Style="{StaticResource SectionHeader}" />
              <TextBlock Style="{StaticResource Hint}">
                Le coffre, puis la case d'arrivée dans votre inventaire, puis les items — dans
                l'ordre du coffre. Vos clics ne parviennent pas au jeu pendant la désignation.
              </TextBlock>

              <WrapPanel Margin="0,8,0,0">
                <Button Content="{Binding DesignationLabel}" Command="{Binding ToggleDesignationCommand}"
                        MinWidth="200" Style="{StaticResource GoldButton}"
                        ToolTip="La macro traite les items à l'envers de l'ordre où vous les désignez. C'est voulu : quand une pile se vide, les items qui la suivaient remontent d'une case, et commencer par la fin met ce décalage derrière ce qu'il reste à faire." />
                <Button Content="Effacer" Command="{Binding ClearChestPointsCommand}" MinWidth="100" />
              </WrapPanel>

              <TextBlock Text="3. Construisez la macro" Style="{StaticResource SectionHeader}" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                          ToolTip="La part est calculée à la première lecture puis reprise pour les autres personnages : le coffre se vide à mesure que chacun se sert, et rediviser ce qu'il reste donnerait au deuxième un quart de ce que le premier a laissé. Une part de plus qu'il n'y a de personnages laisse une marge, si vous préférez qu'aucune pile ne se vide.">
                <TextBlock Text="Diviser chaque pile en" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding ChestDivisor, UpdateSourceTrigger=LostFocus}" Width="50" />
                <TextBlock Text="parts" VerticalAlignment="Center" Margin="6,0,0,0" />
              </StackPanel>
              <Button Content="Construire la macro" Command="{Binding BuildChestMacroCommand}"
                      MinWidth="200" HorizontalAlignment="Left"
                      ToolTip="La macro apparaît dans l'onglet Macros, modifiable comme les autres. Surveillez le premier passage : ce que la macro donne, le jeu ne le rend pas." />
              <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0">
                Surveillez le premier passage : ce que la macro donne, le jeu ne le rend pas.
              </TextBlock>
            </StackPanel>

            <DockPanel Grid.Column="1" MinHeight="240">
              <TextBlock DockPanel.Dock="Top" Text="Points désignés" Style="{StaticResource SectionHeader}"
                         Margin="0,0,0,6" />
              <ListBox ItemsSource="{Binding ChestPoints}" />
            </DockPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- ============ Réglages ============ -->
      <TabItem Header="Réglages">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="Raccourcis globaux" Style="{StaticResource SectionHeader}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Personnage suivant" VerticalAlignment="Center" Margin="0,4" />
              <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Wood}"
                         Text="{Binding Settings.NextCharacterHotkey, TargetNullValue=(aucun)}" />
              <Button Grid.Row="0" Grid.Column="2" Content="Assigner" Command="{Binding AssignNextHotkeyCommand}" Margin="0,2" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Personnage précédent" VerticalAlignment="Center" Margin="0,4" />
              <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Wood}"
                         Text="{Binding Settings.PreviousCharacterHotkey, TargetNullValue=(aucun)}" />
              <Button Grid.Row="1" Grid.Column="2" Content="Assigner" Command="{Binding AssignPreviousHotkeyCommand}" Margin="0,2" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Arrêt d'urgence" VerticalAlignment="Center" Margin="0,4" />
              <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Wood}"
                         Text="{Binding Settings.PanicHotkey, TargetNullValue=(aucun)}" />
              <Button Grid.Row="2" Grid.Column="2" Content="Assigner" Command="{Binding AssignPanicHotkeyCommand}" Margin="0,2" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Démarrer / arrêter l'enregistrement" VerticalAlignment="Center" Margin="0,4" />
              <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Wood}"
                         Text="{Binding Settings.ToggleRecordingHotkey, TargetNullValue=(aucun)}" />
              <Button Grid.Row="3" Grid.Column="2" Content="Assigner" Command="{Binding AssignToggleRecordingHotkeyCommand}" Margin="0,2" />

              <TextBlock Grid.Row="4" Grid.Column="0" Text="Refaire sur l'équipe" VerticalAlignment="Center" Margin="0,4" />
              <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Wood}"
                         Text="{Binding Settings.RepeatOnTeamHotkey, TargetNullValue=(aucun)}" />
              <Button Grid.Row="4" Grid.Column="2" Content="Assigner" Command="{Binding AssignRepeatOnTeamHotkeyCommand}" Margin="0,2" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}">
              « Refaire sur l'équipe » : appuyez une fois sur votre personnage meneur, faites l'action
              (prendre un zaap, enchaîner un dialogue), appuyez de nouveau — les autres personnages la refont.
              Aucune macro à écrire, l'outil n'a pas à savoir de quelle destination il s'agit.
            </TextBlock>
            <TextBlock Style="{StaticResource Hint}">
              L'arrêt d'urgence et la bascule d'enregistrement restent actifs même quand Dofus n'a pas le focus, et même
              pendant une capture : ce sont les seuls moyens de reprendre la main sans revenir dans cette fenêtre.
            </TextBlock>

            <TextBlock Text="Comportement" Style="{StaticResource SectionHeader}" />
            <CheckBox Content="N'activer les raccourcis que lorsqu'une fenêtre Dofus est au premier plan"
                      IsChecked="{Binding Settings.HotkeysOnlyWhenGameFocused}" Margin="0,3" />
            <CheckBox Content="Empêcher les touches assignées d'atteindre le jeu"
                      IsChecked="{Binding Settings.SwallowBoundKeys}" Margin="0,3" />
            <CheckBox Content="Envoyer les touches avec leur code de balayage (à décocher si le jeu ignore les frappes)"
                      IsChecked="{Binding Settings.UseScanCodes}" Margin="0,3" />
            <CheckBox Content="Émettre un bip au début et à la fin d'un enregistrement"
                      IsChecked="{Binding Settings.RecordingFeedbackSound}" Margin="0,3" />

            <TextBlock Text="Enregistrement" Style="{StaticResource SectionHeader}" />
            <CheckBox Content="Enregistrer les temps morts entre deux actions"
                      IsChecked="{Binding Settings.RecordDelays}" Margin="0,3" />
            <TextBlock Text="Temporisations" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal" Margin="0,3">
              <TextBlock Text="Après un changement de fenêtre (ms)" Width="240" VerticalAlignment="Center" />
              <TextBox Text="{Binding Settings.FocusSettleDelayMs, UpdateSourceTrigger=LostFocus}" Width="80" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,3">
              <TextBlock Text="Entre deux actions (ms)" Width="240" VerticalAlignment="Center" />
              <TextBox Text="{Binding Settings.ActionDelayMs, UpdateSourceTrigger=LostFocus}" Width="80" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,3">
              <TextBlock Text="Rejeu sur l'équipe (ms)" Width="240" VerticalAlignment="Center" />
              <TextBox Text="{Binding Settings.TeamReplayDelayMs, UpdateSourceTrigger=LostFocus}" Width="80" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,3">
              <TextBlock Text="Entre deux clics d'un double-clic (ms)" Width="240" VerticalAlignment="Center" />
              <TextBox Text="{Binding Settings.MultiClickIntervalMs, UpdateSourceTrigger=LostFocus}" Width="80" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,3">
              <TextBlock Text="Après un cran de molette (ms)" Width="240" VerticalAlignment="Center" />
              <TextBox Text="{Binding Settings.ScrollDelayMs, UpdateSourceTrigger=LostFocus}" Width="80" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,3">
              <TextBlock Text="Entre deux touches enchaînées (ms)" Width="240" VerticalAlignment="Center" />
              <TextBox Text="{Binding Settings.TypingDelayMs, UpdateSourceTrigger=LostFocus}" Width="80" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}">
              Si des clics se perdent, augmentez le délai après changement de fenêtre : le client a besoin de quelques images avant d'accepter une entrée.
              Le délai du rejeu sur l'équipe est distinct et plus long : ouvrir une carte ou une liste prend bien plus de temps qu'enchaîner deux clics de sort.
            </TextBlock>
            <TextBlock Style="{StaticResource Hint}">
              L'écart d'un double-clic obéit à deux bornes et n'est donc jamais celui des autres délais. Trop court, les deux
              clics tombent dans la même image du jeu, qui n'interroge l'entrée qu'une fois par image : il n'en voit qu'un.
              Trop long, il dépasse le seuil du système — une demi-seconde en général — et le jeu voit deux clics séparés.
              80 ms convient dans la plupart des cas ; montez à 120 ou 150 si un double-clic n'aboutit pas.
              La molette a elle aussi son délai propre, et court : une liste défile à la vitesse où on la fait
              tourner, sans rien à ouvrir ni à charger. Même chose pour des touches qui s'enchaînent, c'est-à-dire
              une saisie — le nom d'un zaap dans un champ de recherche. Seule la dernière touche d'un mot garde le
              délai ordinaire, celle après laquelle le jeu a quelque chose à faire.
            </TextBlock>

            <Button Content="Rétablir les temporisations" Command="{Binding RestoreDefaultDelaysCommand}"
                    MinWidth="200" HorizontalAlignment="Left" Margin="0,10,0,0"
                    ToolTip="Remet les six valeurs ci-dessus à celles d'une installation neuve. Ne touche pas aux touches lentes, qui sont réglées ci-dessous, ni aux raccourcis, ni aux macros." />

            <TextBlock Text="Touches lentes" Style="{StaticResource SectionHeader}" />
            <TextBlock Style="{StaticResource Hint}">
              Certaines touches n'agissent pas sur-le-champ : celle du havre-sac ouvre un panneau qui met
              parfois un moment à apparaître, et le clic suivant partirait dans le vide. Leur accorder une
              attente ici évite de ralentir toute la séquence en montant les délais généraux.
            </TextBlock>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                  <Button Content="Ajouter" Command="{Binding AddSlowKeyCommand}" />
                  <Button Content="Supprimer" Command="{Binding DeleteSlowKeyCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding SlowKeys}" SelectedItem="{Binding SelectedSlowKey}"
                         DisplayMemberPath="Summary" MinHeight="90" MaxHeight="150" />
              </DockPanel>

              <StackPanel Grid.Column="1" IsEnabled="{Binding HasSlowKey}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="Touche" Width="130" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding SelectedSlowKey.Key, TargetNullValue=(aucune)}"
                             Width="150" VerticalAlignment="Center" FontWeight="SemiBold"
                             Foreground="{StaticResource Wood}" />
                  <Button Content="Assigner" Command="{Binding AssignSlowKeyCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Attente en plus (ms)" Width="130" VerticalAlignment="Center" />
                  <TextBox Text="{Binding SelectedSlowKey.ExtraDelayMs, UpdateSourceTrigger=LostFocus}" Width="80" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Hint}">
              Cette attente s'ajoute à la pause ordinaire, elle ne la remplace pas, et vaut pour toutes les
              macros. Elle porte sur la touche et non sur une étape : la séquence de « Refaire sur l'équipe »
              étant recapturée à chaque voyage, une attente ajoutée à la main dans ses étapes serait perdue
              au voyage suivant. Prévoyez large — le retard est subi par chaque personnage.
            </TextBlock>

            <TextBlock Text="Détection des clients" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal" Margin="0,3">
              <TextBlock Text="Motif du titre" Width="130" VerticalAlignment="Center" />
              <TextBox Text="{Binding Settings.TitlePattern, UpdateSourceTrigger=LostFocus}" Width="380" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,3">
              <TextBlock Text="Classe de fenêtre" Width="130" VerticalAlignment="Center" />
              <TextBox Text="{Binding Settings.WindowClassFilter, UpdateSourceTrigger=LostFocus}" Width="380" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}">
              Le groupe (?&lt;name&gt;…) du motif donne le nom du personnage. Laissez la classe vide pour ne pas filtrer ;
              « UnityWndClass » restreint aux clients Dofus Unity. La colonne « Titre de la fenêtre » de l'onglet
              Personnages montre ce que voit l'application, de quoi ajuster le motif.
            </TextBlock>

            <Button Content="Rétablir la détection" Command="{Binding RestoreDefaultDetectionCommand}"
                    MinWidth="200" HorizontalAlignment="Left" Margin="0,6,0,0"
                    ToolTip="Remet le motif du titre à sa valeur d'origine et vide le filtre de classe. La porte de sortie quand un motif saisi à la main ne reconnaît plus aucun personnage." />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button Content="Enregistrer les réglages" Command="{Binding SaveCommand}" MinWidth="170"
                      Style="{StaticResource GoldButton}" />
              <Button Content="Rafraîchir la détection" Command="{Binding RefreshCommand}" MinWidth="170" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
